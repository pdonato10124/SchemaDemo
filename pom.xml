			<!--
			The Javadoc Plugin uses the Javadoc tool to generate javadocs for the specified project. The plugin can also be used to 
			package the generated javadocs into a jar file for distribution.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>${maven-javadoc-plugin.version}</version>
				<configuration>
					<maxmemory>1024m</maxmemory>
					<excludePackageNames>net.opengis.*:org.isotc211.x2005.*:xint.eurocontrol.*:intl.eurocontrol.*:org.w3.*:us.gov.*:noNamespace:gov.faa.nawx.*</excludePackageNames>
					<defaultAuthor>Peter V Donato</defaultAuthor>
					<level>public</level>
					<fixTags>author,param,return,throws</fixTags>
					<outputDirectory>${basedir}/target/generated-sources</outputDirectory>
