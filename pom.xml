	<reporting>
		<plugins>
		
			<!-- 
			JavaNCSS is a source measurement suite for Java which produces quantity and complexity metrics for your java source code. 
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>javancss-maven-plugin</artifactId>
				<version>${javancss-maven-plugin.version}</version>
				<configuration>
					<ncssLimit>350</ncssLimit>
					<ccnLimit>20</ccnLimit>
					<failOnViolation>false</failOnViolation>
					<linkXRef>true</linkXRef>
				</configuration>
			</plugin>
			
			<!-- 
			PMD is a source code analyzer. It finds unused variables, empty catch blocks, unnecessary object creation, and so forth. 
			This plugin also supports the separate Copy/Paste Detector tool (or CPD) distributed with PMD.
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${maven-pmd-plugin.version}</version>
				<configuration>
					<targetJdk>${maven.compiler.source}</targetJdk>
					<linkXRef>true</linkXRef>
				</configuration>
			</plugin>
			-->
			
			<!--
			The JDepend Maven plugin produces a nicely formatted metrics report based on your project.
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jdepend-maven-plugin</artifactId>
				<version>${jdepend-maven-plugin.version}</version>
			</plugin>
			-->

			<!--
			The Surefire Plugin is used during the test phase of the build lifecycle to execute the unit tests of an application. 
			It generates reports in 2 different file formats: Plain text files (*.txt), XML files (*.xml)
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven-surefire-plugin.version}</version>
				<configuration>
					<skip>${maven.test.skip}</skip>
					<testFailureIgnore>${maven.test.failure.ignore}</testFailureIgnore>
				</configuration>
			</plugin>
			
			<!-- 
			The JXR Plugin produces a cross-reference of the project's sources. The generated reports make it easier for the user to reference
			or find specific lines of code. It is also handy when used with the PMD Plugin for referencing errors found in the code. 
			2.3 -> 2.4 02/03/2017 pvd -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jxr-plugin</artifactId>
				<version>3.1.1</version>   <!-- 2.4 -> 3.1.1 10/30/2021 pvd -->
			</plugin>
			
